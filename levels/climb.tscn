[node name="Level" type="Node2D"]
script = ExtResource("1_lvl")
hud = "THE WHIP - THE CLIMB   (--level climb)   18 doors, 40 m up, 4 sections. Every door: stand at the lip, catch the beam, pump, let go on the way up.
PUMP: reach DOWN the rope as you pass under the beam (M on: pull UP toward it). STICK: press it into the rock to plant it.
M = mouse flip, P = stick (normal / springy / hammer), C [ ] = crack, sensitivity, 1 2 3 L = control modes. F11 = fullscreen.
Fall into a shaft and you are back at the start of the section. R = restart there."

