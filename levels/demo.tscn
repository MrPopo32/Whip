[node name="Level" type="Node2D"]
script = ExtResource("1_lvl")
hud = "THE WHIP   -   a whip is your only tool and your only way to move
Throw it at the branch ahead and HOLD (Space or click). Step off the edge: the drop is your swing. Let go on the way up and fly.
To land higher, pull the mouse DOWN the rope each time you pass under the branch. Fall and you are back at the last flag.
F1 = more readouts   F11 = fullscreen   R = restart"
greybox = false

