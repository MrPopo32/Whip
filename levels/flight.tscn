[node name="Level" type="Node2D"]
script = ExtResource("1_lvl")
hud = "THE WHIP - THE FLIGHT   (--level flight)   17 beams, 4 sections, uphill. Throw at the beam ahead, hold, step off the edge: the drop is your swing. Let go on the way up and fly.
LIFT: pull the mouse DOWN the rope as you pass under the beam, and you fly higher. Earlier = shorter, later = longer.
Fall and you are back at the start of the section. R = restart there. F11 = fullscreen."

